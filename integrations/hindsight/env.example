# Load real secrets from the service's environment or an approved secret store.
KULO_HINDSIGHT_ROUTER_API_KEY=
KULO_HINDSIGHT_WORKER_API_KEY=
# Optional service-manager identity. Keep this out of Hub runtime settings and
# execution-node environments. Only bank initialization and verification cleanup.
KULO_HINDSIGHT_MANAGEMENT_API_KEY=
KULO_HINDSIGHT_PRIVATE_BANK=kulo-core
KULO_HINDSIGHT_SHARED_BANK=kulo-shared

# Keep the existing database/data volume. An explicit username and an independent
# password of at least 32 printable non-space ASCII characters are required.
# Supported: postgresql://user:<url-encoded-password>@host/database
# Embedded: pg0://user:<url-encoded-password>@instance-name
HINDSIGHT_API_DATABASE_URL=
HINDSIGHT_API_DATABASE_SCHEMA=public
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888

# Keep the deployment's existing LLM and embedding settings. Kulo uses REST only.
HINDSIGHT_API_MCP_ENABLED=false

