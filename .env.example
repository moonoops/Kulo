# ==============================================================================
# Moco SuperAgent Configuration (OpenAI / NewAPI Compatible Mode)
# ==============================================================================

# 1. OpenAI-Compatible Gateway (NewAPI / OneAPI / OpenRouter / DeepSeek / OpenAI)
# Bare origins like https://api.example.com are automatically normalized to /v1
MOCO_BASE_URL=https://api.openai.com/v1
MOCO_API_KEY=sk-your-api-key-here

# API Wire Protocol: "openai-completions" (default for NewAPI) or "openai-responses"
MOCO_API_MODE=openai-completions
MOCO_DEFAULT_PROVIDER=

# 2. Model Routing (Main Moco Orchestrator + Per-Role Worker Overrides)
MOCO_MODEL=gpt-4o
MOCO_SCOUT_MODEL=
MOCO_ARCHITECT_MODEL=
MOCO_CODER_MODEL=
MOCO_CHECKER_MODEL=
MOCO_DESIGNER_MODEL=
MOCO_WRITER_MODEL=

# Optional default thinking/reasoning effort & context window
MOCO_THINKING_LEVEL=medium
MOCO_CONTEXT_WINDOW=256000

# 3. Hub Server, Nodes & Storage
MOCO_HUB_HOST=127.0.0.1
MOCO_HUB_PORT=7788
# Required management/client credential; never share it with an Env node or memory identity
MOCO_AUTH_TOKEN=
# Hub-side node credentials: JSON object mapping each Env ID to its own token
MOCO_ENV_TOKENS={}
# Approved remote sandboxed Env IDs (comma-separated); local macOS uses the built-in sandbox
MOCO_WORKER_ENV_IDS=
# Execution node only; does not authorize management or memory access
MOCO_ENV_TOKEN=
# Native computer-use on this executing device (default: browser,desktop; leave empty to disable both)
# Set this separately on each Env; the Hub value controls only its built-in local Env.
MOCO_COMPUTER_USE=browser,desktop
# Optional override path for the mobile TLS connector binary (built by Moco-mobile)
MOCO_CONNECTOR_PATH=
# Durable state directory (stores moco.sqlite, identity & relationship documents & default Moco's table workspaces)
MOCO_STATE_DIR=./.moco-state

# 4. Personal Identity Documents & Hindsight Dual-Bank Memory
# Leave MOCO_IDENTITY_DIR empty to use <MOCO_STATE_DIR>/identity automatically
MOCO_IDENTITY_DIR=
MOCO_HINDSIGHT_ENABLED=false
MOCO_HINDSIGHT_URL=http://127.0.0.1:8888
MOCO_HINDSIGHT_ENDPOINTS=
# Distinct 32+ character credentials; configure the same values in the Hindsight in-process extension
MOCO_HINDSIGHT_ROUTER_API_KEY=
MOCO_HINDSIGHT_WORKER_API_KEY=
MOCO_HINDSIGHT_SHARED_READ_API_KEY=
MOCO_HINDSIGHT_PRIVATE_BANK=moco-core
MOCO_HINDSIGHT_SHARED_BANK=moco-shared

# Legacy Tavily key: imported once into Settings → Capabilities & Skills → Search; manage all search plans there
MOCO_SEARCH_API_KEY=

# 5. Worker Concurrency & Supervision
MOCO_MAX_WORKERS=3
MOCO_MAX_SUBAGENTS_PER_TICKET=4
MOCO_WATCHDOG_MINUTES=5
