# ==============================================================================
# Kulo SuperAgent Configuration (OpenAI / NewAPI Compatible Mode)
# ==============================================================================

# 1. OpenAI-Compatible Gateway (NewAPI / OneAPI / OpenRouter / DeepSeek / OpenAI)
# Bare origins like https://api.example.com are automatically normalized to /v1
KULO_BASE_URL=https://api.openai.com/v1
KULO_API_KEY=sk-your-api-key-here

# API Wire Protocol: "openai-completions" (default for NewAPI) or "openai-responses"
KULO_API_MODE=openai-completions
KULO_DEFAULT_PROVIDER=

# 2. Model Routing (Main Kulo Orchestrator + Per-Role Worker Overrides)
KULO_MODEL=gpt-4o
KULO_SCOUT_MODEL=
KULO_ARCHITECT_MODEL=
KULO_CODER_MODEL=
KULO_CHECKER_MODEL=
KULO_DESIGNER_MODEL=
KULO_WRITER_MODEL=

# Optional default thinking/reasoning effort & context window
KULO_THINKING_LEVEL=medium
KULO_CONTEXT_WINDOW=256000

# 3. Hub Server, Nodes & Storage
KULO_HUB_HOST=127.0.0.1
KULO_HUB_PORT=7788
# Required management/client credential; never share it with an Env node or memory identity
KULO_AUTH_TOKEN=
# Hub-side node credentials: JSON object mapping each Env ID to its own token
KULO_ENV_TOKENS={}
# Approved remote sandboxed Env IDs (comma-separated); local macOS uses the built-in sandbox
KULO_WORKER_ENV_IDS=
# Execution node only; does not authorize management or memory access
KULO_ENV_TOKEN=
# Native computer-use on this executing device (default: browser,desktop; leave empty to disable both)
# Set this separately on each Env; the Hub value controls only its built-in local Env.
KULO_COMPUTER_USE=browser,desktop
# Optional override path for the mobile TLS connector binary (built by Kulo-mobile)
KULO_CONNECTOR_PATH=
# Durable state directory (stores kulo.sqlite, identity & relationship documents & default Kulo's table workspaces)
KULO_STATE_DIR=./.kulo-state

# 4. Personal Identity Documents & Hindsight Dual-Bank Memory
# Leave KULO_IDENTITY_DIR empty to use <KULO_STATE_DIR>/identity automatically
KULO_IDENTITY_DIR=
KULO_HINDSIGHT_ENABLED=false
KULO_HINDSIGHT_URL=http://127.0.0.1:8888
KULO_HINDSIGHT_ENDPOINTS=
# Distinct 32+ character credentials; configure the same values in the Hindsight in-process extension
KULO_HINDSIGHT_ROUTER_API_KEY=
KULO_HINDSIGHT_WORKER_API_KEY=
KULO_HINDSIGHT_SHARED_READ_API_KEY=
KULO_HINDSIGHT_PRIVATE_BANK=kulo-core
KULO_HINDSIGHT_SHARED_BANK=kulo-shared

# Legacy Tavily key: imported once into Settings → Capabilities & Skills → Search; manage all search plans there
KULO_SEARCH_API_KEY=

# 5. Worker Concurrency & Supervision
KULO_MAX_WORKERS=3
KULO_MAX_SUBAGENTS_PER_TICKET=4
KULO_WATCHDOG_MINUTES=5
